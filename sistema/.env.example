# =====================================================================
#  ZERA CONTÁBIL MAX — configurações
#  O Ferramentas\INSTALAR.bat cria o arquivo .env a partir deste modelo e gera as
#  senhas sozinho. NUNCA envie o .env para o Git nem para ninguém.
# =====================================================================

# --- Banco de dados (PostgreSQL no Docker) ---
# Atenção: depois que o banco for criado, NÃO troque a senha aqui
# (o banco continuaria com a senha antiga e o sistema não conectaria).
POSTGRES_USER=zera
POSTGRES_PASSWORD=GERAR_AUTOMATICAMENTE
POSTGRES_DB=zera_contabil_max
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Na nuvem (Fase 4) basta preencher a linha abaixo; ela passa a valer no lugar das de cima:
# DATABASE_URL=postgresql+psycopg://usuario:senha@servidor:5432/banco

# --- Pastas (relativas à pasta do sistema, ou caminho completo) ---
PASTA_ARQUIVOS=dados/arquivos
PASTA_BACKUP=dados/backups
# Cópia dos backups no Google Drive. Em branco = o sistema encontra sozinho a pasta
# "Meu Drive\Backups ZERA CONTABIL MAX" quando o Google Drive para computador está instalado.
# Pode ser um caminho completo (ex.: G:\Meu Drive\Backups ZERA) ou NAO para não copiar.
PASTA_BACKUP_NUVEM=

# --- Servidor web ---
# 127.0.0.1 = só este computador. 0.0.0.0 = rede do escritório: use o Ferramentas\LIBERAR_REDE.bat
# (como administrador), que também libera a porta no Firewall. Passo a passo: Manuais\3 - Usar em outros computadores.md
HOST=127.0.0.1
PORTA=8000
CHAVE_SESSAO=GERAR_AUTOMATICAMENTE

# --- Inteligência artificial (API da Anthropic) ---
# Cole a chave criada em console.anthropic.com depois do sinal de igual (sem espaços, sem aspas).
# Em branco = IA desligada: o sistema continua funcionando só com regras e aprendizado.
ANTHROPIC_API_KEY=
# Modelo rápido e barato (lotes) e modelo forte (configuração, PDF, casos difíceis)
IA_MODELO_RAPIDO=claude-haiku-4-5
IA_MODELO_FORTE=claude-sonnet-5-5
# Gasto máximo por mês, em dólares, somando todas as empresas (ao atingir, a IA para e avisa)
IA_LIMITE_MENSAL_USD=20
